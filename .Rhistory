library(tidyverse)
library(gt)
library(janitor)
library(rstatix)
library(knitr)
library(gtsummary)
library(moderndive)
library(broom)
library(here)
library(ggplot2)
library(ggpubr)
library(boot) # for inv.logit()
library(lmtest)
library(epiDisplay)
load(here("data", "bc_diagnosis.Rda"))
mean_age = mean(bc$Age)
bc = bc %>% mutate(Late_stage_num = as.numeric(Late_stage_diag)-1,
Age_c = Age - mean(Age))
# Chunk 2
bc_reg = bc %>% glm(formula = Late_stage_diag ~ Age_c, family = binomial)
tidy(bc_reg, conf.int=T) %>% gt() %>% tab_options(table.font.size = 38) %>%
fmt_number(decimals = 3)
# Chunk 4
bc_reg = bc %>%
glm(formula = Late_stage_diag ~ Age_c, family = binomial)
# Chunk 5
tidy_bc_reg = tidy(bc_reg, conf.int=T, exponentiate = T)
tidy_bc_reg %>% gt() %>% tab_options(table.font.size = 35) %>%
fmt_number(decimals = 3)
tidy_bc_reg$conf.low # I prefer tidy() bc now I can grab each component
# Chunk 6
logistic.display(bc_reg) # Cannot grab each component in this
# Chunk 7
bc_reg = glm(Late_stage_diag ~ Age_c, data = bc, family = binomial)
tidy(bc_reg, conf.int=T) %>% gt() %>% tab_options(table.font.size = 35) %>%
fmt_number(decimals = 3)
# Chunk 8
bc2 = bc %>% mutate(Age_c_10 = Age_c/10)
bc_reg_10 = glm(Late_stage_diag ~ Age_c_10, data = bc2, family = binomial)
tidy(bc_reg_10, conf.int=T, exponentiate = T) %>% gt() %>% tab_options(table.font.size = 35) %>%
fmt_number(decimals = 3)
# Chunk 9
bc3 = bc %>% mutate(Age_binary = ifelse(Age > 65, 1, 0))
age_bin_glm = bc3 %>% glm(formula = Late_stage_diag ~ Age_binary, family = binomial)
# Chunk 10
age_bin_tidy = tidy(age_bin_glm, conf.int=T, exponentiate = T)
age_bin_tidy %>% gt() %>%
tab_options(table.font.size = 35) %>%
fmt_number(decimals = 3)
# Chunk 11
RE_glm = bc %>%
glm(formula = Late_stage_diag ~ Race_Ethnicity, family = binomial)
# Chunk 12
RE_tidy = tidy(RE_glm, conf.int=T, exponentiate = T)
RE_tidy %>% gt() %>%
tab_options(table.font.size = 35) %>%
fmt_number(decimals = 3)
library(gmodels)
RE_glm %>% estimable(
c("(Intercept)" = 0,      # beta0
"Race_EthnicityHispanic-Latino"= 0, # beta1
"Race_EthnicityNH American Indian/Alaskan Native" = 0, # beta2
"Race_EthnicityNH Asian/Pacific Islander"  = 1, # beta3
"Race_EthnicityNH Black" = -1),  # beta4
conf.int = 0.95)
RE_glm %>% estimable(
c("(Intercept)" = 0,      # beta0
"Race_EthnicityHispanic-Latino"= 0, # beta1
"Race_EthnicityNH American Indian/Alaskan Native" = 0, # beta2
"Race_EthnicityNH Asian/Pacific Islander"  = 1, # beta3
"Race_EthnicityNH Black" = -1),  # beta4
conf.int = 0.95) %>% exp(.)
