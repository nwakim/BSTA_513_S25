# Chunk 2
icu = read.csv(here("data", "icu.csv"))
icu1 = icu %>% mutate(STA = as.factor(STA) %>% relevel(ref = "Lived"))
icu2 = icu1 %>% mutate(CAN = as.factor(CAN) %>% relevel(ref = "No"),
CPR = as.factor(CPR) %>% relevel(ref = "No"),
INF = as.factor(INF) %>% relevel(ref = "No"),
LOC = as.factor(LOC) %>%
relevel(ref = "No Coma or Deep Stupor"))
# Chunk 3
model1 = glm(STA ~ AGE + CAN + CPR + INF,
data = icu2, family = binomial)
m1_tidy = tidy(model1, conf.int = T)
m1_tidy %>% gt() %>%
tab_options(table.font.size = 16) %>%
fmt_number(decimals = 3)
# Chunk 4
model2 = glm(formula= STA ~ 1, data = icu2,
family = binomial)
lmtest::lrtest(model1, model2)
# Chunk 5
model_int = glm(STA ~ CAN + INF + CAN*INF, data = icu2,
family = binomial)
model_int_tidy = tidy(model_int, conf.int = T)
model_int_tidy %>% gt() %>%
tab_options(table.font.size = 16) %>%
fmt_number(decimals = 3)
# Chunk 6
model_int_tidy %>% gt() %>%
tab_options(table.font.size = 16) %>%
fmt_number(decimals = 3)
# Chunk 7
model_no_int = glm(STA ~ CAN + INF, data = icu2,
family = binomial)
lmtest::lrtest(model_int, model_no_int)
# Chunk 8
tbl_regression(model_int, exponentiate=T,
include = c("CAN", "INF")) %>%
# include allows my to select only the main effects to print
as_gt() %>%
tab_options(table.font.size = 16) %>%
fmt_number(decimals = 3)
# Chunk 9
model_int_tidy = tidy(model_int, conf.int = T, exponentiate = T)
model_int_tidy %>% gt() %>%
tab_options(table.font.size = 16) %>%
fmt_number(decimals = 3)
model_int_tidy_coef = tidy(model_int)
model_int_tidy_coef
model_int
exp(.)
